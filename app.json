{
  "expo": {
    "name": "Luzidio",
    "slug": "luzidio",
    "scheme": "luzidio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B1026",
    "ios": {
      "bundleIdentifier": "com.luzidio.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.luzidio.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B1026",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "Luzidio",
      "shortName": "Luzidio",
      "lang": "de",
      "themeColor": "#0B1026",
      "backgroundColor": "#0B1026"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "Luzidio nutzt das Mikrofon, damit du Träume als Sprachmemo festhalten kannst. Aufnahmen bleiben auf deinem Gerät."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Luzidio nutzt Face ID, um dein Traumtagebuch zu schützen."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#8B7CF6"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B1026"
        }
      ],
      "expo-sharing",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/luzidio"
    }
  }
}
